# Development-only example. In Azure every secret comes from Key Vault via managed identity (see infra/terraform).
CRM_ENV=local
CRM_DATABASE_URL=postgresql+asyncpg://crm_app:crm_app_dev@localhost:5432/crm
CRM_MIGRATION_DATABASE_URL=postgresql+asyncpg://crm_owner:crm_owner_dev@localhost:5432/crm
CRM_REDIS_URL=redis://localhost:6379/0
CRM_JWT_SIGNING_KEY=local-dev-only-signing-key-change-me-please-0123456789
CRM_COOKIE_SECURE=false
CRM_BLOB_PROVIDER=azurite
CRM_BLOB_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
CRM_VIRUS_SCAN_PROVIDER=none
CRM_KYC_KEY_PROVIDER=local
CRM_AADHAAR_FULL_STORAGE_ENABLED=false
